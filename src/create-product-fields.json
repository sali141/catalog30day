        "Roaming Data": [
          { "name": "allowances.Roaming Data.unlimited", "label": "Unlimited", "type": "switch", "required": false },
          { "name": "allowances.Roaming Data.amount", "label": "Data", "type": "number", "required": true, "hiddenWhen": "unlimited = true" },
          { "name": "allowances.Roaming Data.unit", "label": "Unit", "type": "select", "required": true, "options": ["GB", "MB"], "hiddenWhen": "unlimited = true" },
          { "name": "allowances.Roaming Data.dataSharing", "label": "Data Sharing", "type": "switch", "required": false },
          { "name": "allowances.Roaming Data.productSpeed", "label": "Product Speed", "type": "select", "required": false, "options": ["Uncapped", "Capped", "Throttled"] },
          { "name": "allowances.Roaming Data.listOfApps", "label": "List of Apps", "type": "select", "required": false, "options": ["All", "Social", "Streaming", "Messaging"] },
          {
            "name": "allowances.Roaming Data.countries",
            "label": "Select Countries",
            "type": "multi-select",
            "required": true,
            "options": ["Australia", "France", "Germany", "India", "Japan", "Singapore", "Sri Lanka", "United Kingdom", "United States"]
          }
        ],
        "Local Voice": [
          { "name": "allowances.Local Voice.unlimited", "label": "Unlimited", "type": "switch", "required": false },
          { "name": "allowances.Local Voice.amount", "label": "Voice", "type": "number", "required": true, "hiddenWhen": "unlimited = true" },
          { "name": "allowances.Local Voice.unit", "label": "Unit", "type": "select", "required": true, "options": ["Minutes"], "hiddenWhen": "unlimited = true" },
          { "name": "allowances.Local Voice.voiceSharing", "label": "Voice Sharing", "type": "switch", "required": false }
        ],
        "Roaming Voice": [
          { "name": "allowances.Roaming Voice.unlimited", "label": "Unlimited", "type": "switch", "required": false },
          { "name": "allowances.Roaming Voice.amount", "label": "Voice", "type": "number", "required": true, "hiddenWhen": "unlimited = true" },
          { "name": "allowances.Roaming Voice.unit", "label": "Unit", "type": "select", "required": true, "options": ["Minutes"], "hiddenWhen": "unlimited = true" },
          { "name": "allowances.Roaming Voice.voiceSharing", "label": "Voice Sharing", "type": "switch", "required": false },
          {
            "name": "allowances.Roaming Voice.countries",
            "label": "Select Countries",
            "type": "multi-select",
            "required": true,
            "options": ["Australia", "France", "Germany", "India", "Japan", "Singapore", "Sri Lanka", "United Kingdom", "United States"]
          }
        ],
        "Local SMS": [
          { "name": "allowances.Local SMS.unlimited", "label": "Unlimited", "type": "switch", "required": false },
          { "name": "allowances.Local SMS.amount", "label": "SMS", "type": "number", "required": true, "hiddenWhen": "unlimited = true" },
          { "name": "allowances.Local SMS.smsSharing", "label": "SMS Sharing", "type": "switch", "required": false }
        ],
        "Roaming SMS": [
          { "name": "allowances.Roaming SMS.unlimited", "label": "Unlimited", "type": "switch", "required": false },
          { "name": "allowances.Roaming SMS.amount", "label": "SMS", "type": "number", "required": true, "hiddenWhen": "unlimited = true" },
          { "name": "allowances.Roaming SMS.smsSharing", "label": "SMS Sharing", "type": "switch", "required": false },
          {
            "name": "allowances.Roaming SMS.countries",
            "label": "Select Countries",
            "type": "multi-select",
            "required": true,
            "options": ["Australia", "France", "Germany", "India", "Japan", "Singapore", "Sri Lanka", "United Kingdom", "United States"]
          }
        ]
      }
    },
    "pricing": [
      {
        "name": "basePrice",
        "label": "Base price",
        "type": "number",
        "required": false,
        "prefix": "$",
        "precision": 2,
        "min": 0
      }
    ],
    "notifications": [
      {
        "name": "thresholdNotifications.100 MB.enabled",
        "label": "Threshold Notification Data — 100 MB enabled",
        "type": "switch",
        "required": false
      },
      {
        "name": "thresholdNotifications.100 MB.template",
        "label": "Threshold Notification Data — 100 MB template",
        "type": "text",
        "required": false,
        "default": "usage_notification_addon_data"
      },
      {
        "name": "thresholdNotifications.512 MB.enabled",
        "label": "Threshold Notification Data — 512 MB enabled",
        "type": "switch",
        "required": false
      },
      {
        "name": "thresholdNotifications.512 MB.template",
        "label": "Threshold Notification Data — 512 MB template",
        "type": "text",
        "required": false,
        "default": "usage_notification_addon_data"
      },
      {
        "name": "thresholdNotifications.1 GB.enabled",
        "label": "Threshold Notification Data — 1 GB enabled",
        "type": "switch",
        "required": false
      },
      {
        "name": "thresholdNotifications.1 GB.template",
        "label": "Threshold Notification Data — 1 GB template",
        "type": "text",
        "required": false,
        "default": "usage_notification_addon_data"
      },
      {
        "name": "subscriptionNotification.enabled",
        "label": "Subscription notification enabled",
        "type": "switch",
        "required": false,
        "default": true
      },
      {
        "name": "subscriptionNotification.template",
        "label": "Subscription notification template",
        "type": "text",
        "required": false,
        "default": "addon_subscribe"
      },
      {
        "name": "fairUseNotification",
        "label": "FUP limit — Notify when full-speed data is exhausted",
        "type": "switch",
        "required": false,
        "default": false
      }
    ]
  },
